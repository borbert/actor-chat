# Convex deployment URL (same as CONVEX_URL in the repo root .env.local)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Clerk publishable key (dashboard → API keys → React)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Actor server WebSocket URLs (picked in-app after sign-in)
VITE_WS_URL_GO=ws://localhost:8080
VITE_WS_URL_RUST=ws://localhost:8090
# VITE_WS_URL_ZIG=ws://localhost:8100
# Also required:
# 1. Clerk dashboard → Configure → JWT Templates → New template → "Convex"
#    preset. Keep the name exactly "convex".
# 2. On the Convex deployment (issuer domain is shown on the JWT template):
#    bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
